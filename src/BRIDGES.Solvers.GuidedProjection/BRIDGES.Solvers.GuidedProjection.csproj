<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	  <Title>BRIDGES.Solvers.GuidedProjection</Title>
	  <Authors>Nicolas MONTAGNE, Romain MESNIL</Authors>
	  <Company>ENPC - Build'In</Company>
	  <Description>Extension of BRIDGES implementing the Guided Projection Algorithm.</Description>

	  <TargetFramework>net8.0</TargetFramework>
      <ImplicitUsings>disable</ImplicitUsings>
      <Nullable>enable</Nullable>
	  <LangVersion>latest</LangVersion>
	  <OutputType>Library</OutputType>

	  <RepositoryUrl>https://github.com/bridges-libraries/GuidedProjection</RepositoryUrl>
	  <RepositoryType>git</RepositoryType>

	  <GenerateDocumentationFile>true</GenerateDocumentationFile>
	  <IncludeSymbols>true</IncludeSymbols>

	  <PackageId>BRIDGES.Solvers.GuidedProjection</PackageId>
	  <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BRIDGES" Version="0.0.1-beta" />
  </ItemGroup>
	
</Project>
